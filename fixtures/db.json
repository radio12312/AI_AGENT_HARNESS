  "kb_articles": [
    {
      "id": "KB-001",
      "title": "Refund Policy",
      "tags": [
        "refund",
        "refunds",
        "money back",
        "return"
      ],
      "body": "Refunds are available for orders delivered within the last 30 days. Support agents may issue refunds of up to $200.00 per order; any refund above $200.00 must be escalated to a human specialist. Approved refunds are returned to the original payment method and usually arrive within 5-7 business days. Each order can only be refunded once."
    },
    {
      "id": "KB-002",
      "title": "Shipping Times",
      "tags": [
        "shipping",
        "delivery",
        "express",
        "standard"
      ],
      "body": "Standard shipping takes 3-5 business days. Express shipping takes 1-2 business days. Orders placed before 2 PM ET on a business day ship the same day. A tracking number is emailed as soon as an order ships."
    },
    {
      "id": "KB-003",
      "title": "Returns and Exchanges",
      "tags": [
        "return",
        "exchange",
        "label"
      ],
      "body": "To return an item, contact support to receive a prepaid return label. Items should be returned in their original packaging with all accessories. Exchanges are shipped once the returned item is received at our warehouse."
    },
    {
      "id": "KB-004",
      "title": "Product Warranty",
      "tags": [
        "warranty",
        "defect",
        "repair",
